# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design canvas scratch (Claude Design mockups, not app code)
.design-settings/

# hoa-yard-service/ (separate Vite+Spring Boot project, own build outputs)
hoa-yard-service/frontend/node_modules/
hoa-yard-service/frontend/dist/
hoa-yard-service/frontend/dev-dist/
hoa-yard-service/backend/target/
hoa-yard-service/backend/data/
